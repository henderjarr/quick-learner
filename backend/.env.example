# Copy this file to .env (in this same backend/ folder) and paste your key after the =.
# .env is git-ignored, so your key never gets committed.

# Required: the app uses OpenAI by default, and the backend won't start without it.
OPENAI_API_KEY=

# Optional: only needed if you switch chat() in ai_service.py to provider="anthropic".
ANTHROPIC_API_KEY=
